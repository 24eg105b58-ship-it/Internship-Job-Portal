# ===================================================
# Internship & Job Portal - Git Ignore Configuration
# ===================================================

# Environment Variables & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.*
!.env.example
*.env
*.env.local

# Backend Build & Runtime Artifacts
backend/target/
backend/data/
backend/uploads/
backend/target-uploads/
backend/*.log
backend/.flattened-pom.xml
*.class

# Frontend Dependencies & Build Output
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.eslintcache
frontend/*.tsbuildinfo

# IDEs & Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project/
.classpath

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
