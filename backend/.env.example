# ====================================================================
# Render Backend Environment Variables (Configured in Render Dashboard)
# ====================================================================

# Port is automatically assigned by Render (default: 8080 or 10000)
PORT=8080

# Spring Active Profile (prod activates MySQL configuration)
SPRING_PROFILES_ACTIVE=prod

# Production Database Credentials (e.g. from Aiven, TiDB Cloud, Clever Cloud, or RDS)
SPRING_DATASOURCE_URL=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# Production JWT Secret (must be a 256-bit+ secure hex or base64 key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351

# Allowed Frontend Origins for CORS (can be comma-separated or * during setup)
# Example: https://internship-portal.vercel.app,http://localhost:5173
FRONTEND_URL=*
